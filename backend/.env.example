# ============================================================
# ASCEND AI — Backend Environment Variables
# Copy this file to .env and fill in all REQUIRED values
# ============================================================

# === REQUIRED — App will not start without these ===
DATABASE_URL=postgresql://user:password@host:5432/ascend_ai
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32
LLM_API_KEY=your_llm_provider_api_key_here
LLM_BASE_URL=https://api.your-llm-provider.com/v1
LLM_MODEL=llama-3.3-70b-instruct
# Used after primary 429/5xx retries. Empty disables. Groq default is llama-3.1-8b-instant.
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# === SECURITY ===
BACKEND_CORS_ORIGINS=["https://your-vercel-app.vercel.app"]
ALLOWED_ORIGINS=["https://your-vercel-app.vercel.app"]
ENVIRONMENT=production

# === DISPLAY ===
LLM_MODEL_DISPLAY_NAME=Llama 3.3

# === OPTIONAL SERVICES ===
REDIS_URL=redis://your-redis-host:6379
SENTRY_DSN=https://xxx@sentry.io/xxxxx

# === WORKERS (REDIS_URL is required in production for quotas) ===
WEB_CONCURRENCY=1

# === DAILY QUOTAS (0 = unlimited). Shared across /ask, /ask/stream, /practice, mock starts, /revision-plan ===
QUOTA_DAILY_FREE=20
QUOTA_DAILY_PLUS=100
QUOTA_DAILY_PRO=500

# === RAZORPAY (create plans in the Razorpay dashboard, paste IDs here) ===
# Webhook URL: https://<railway-host>/billing/webhook  (HMAC on the raw body)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PLUS=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLUS_PRICE_INR=299
RAZORPAY_PRO_PRICE_INR=799

# === EMAIL (required for account verification) ===
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@yourdomain.com
FRONTEND_URL=https://your-vercel-app.vercel.app
# production defaults to true if unset; explicit false disables
REQUIRE_EMAIL_VERIFICATION=true

# === FEATURE FLAGS ===
ALLOW_FALLBACK_QUESTIONS=false

# === TOKEN TTL ===
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
LLM_TIMEOUT_SECONDS=120
# Chroma/vector retrieve deadline. 0 disables. Timed-out queries use PYQ JSON keyword fallback.
RAG_QUERY_TIMEOUT_SECONDS=8

# === DATABASE POOL (tune for your Railway plan) ===
# Free tier: max 25 connections → pool_size=5, max_overflow=10 is safe with 2 workers
# Pro tier: max 100 connections → pool_size=10, max_overflow=20
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10