# === Database ===
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_password_here
DATABASE_URL=postgresql://your_db_user:your_strong_password_here@db:5432/your_db_name

# === Security ===
JWT_SECRET=your_jwt_secret_here

# === LLM Adapter ===
# Defaults below keep today's Groq-compatible endpoint. For self-hosting, point
# LLM_BASE_URL at vLLM/SGLang/Ollama's OpenAI-compatible /v1 endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_or_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=120
# Required only when LLM_BASE_URL points at Anthropic's native Messages API.
LLM_ANTHROPIC_VERSION=2023-06-01
# Compatibility alias used only when LLM_API_KEY is unset.
GROQ_API_KEY=your_groq_api_key_here

# === RAG ===
# On Railway, attach a volume. The app will default to
# $RAILWAY_VOLUME_MOUNT_PATH/chroma when that Railway env var exists.
# Set this explicitly if your volume mount path is known.
# If Railway denies writes to the mounted volume, set RAILWAY_RUN_UID=0.
RAG_CHROMA_PATH=/data/chroma
RAG_REQUIRE_PERSISTENT_CHROMA=true
RAG_COLLECTION_NAME=ascend_rag
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# === Environment ===
ENVIRONMENT=production
DEBUG=false
REQUIRE_EMAIL_VERIFICATION=false

# === API ===
BACKEND_CORS_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:3000
